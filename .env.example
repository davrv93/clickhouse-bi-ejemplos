# Copia este archivo como .env (Windows: Copy-Item .env.example .env · Mac: cp .env.example .env)
# .env no se sube a GitHub: está en .gitignore.

# Usuario y clave de ClickHouse. Son los del curso; si los cambias, abre el tablero con
# http://127.0.0.1:8080/?usuario=TU_USUARIO&clave=TU_CLAVE
CH_USER=taller
CH_PASSWORD=taller123

# Puertos en tu máquina. Cámbialos solo si ya están ocupados.
CH_PUERTO=8123
TABLERO_PUERTO=8080

# Opcional (videos 4 y 7): tu llave de DeepSeek para pedir reglas nuevas.
# Sin llave, el curso usa las reglas ya revisadas que trae el repositorio.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
